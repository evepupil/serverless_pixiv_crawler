# ==========================================
# Pixiv 爬虫东京服务器 - 环境变量配置
# ==========================================

# Turso 数据库配置 (必需)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_auth_token_here

# Turso 本地副本 URL (可选，启用 Local Read Replica)
# 在东京服务器上配置此项可将查询延迟降至微秒级
# TURSO_SYNC_URL=file:///path/to/local/replica.db

# Pixiv 配置 (必需)
PIXIV_COOKIE=your_pixiv_cookie_here

# B2 存储配置 (可选，用于图片下载功能)
B2_APPLICATION_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_key
B2_BUCKET_NAME=your_bucket_name
B2_BUCKET_ID=your_bucket_id
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
# B2 公开访问地址 (Worker代理地址，用于图片公开访问)
B2_BUCKET_URL=https://your-b2-proxy.example.com
# Requested original files larger than this limit will downgrade to smaller sizes before upload.
ARCHIVE_MAX_ORIGINAL_MB=10

# 服务器配置
PORT=3000

# ==========================================
# 调度器配置 (单位: 分钟)
# ==========================================

# 首页推荐爬取间隔 (默认: 10分钟)
SCHEDULER_HOME_INTERVAL=10

# 插画推荐任务处理间隔 (默认: 15分钟)
SCHEDULER_ILLUST_RECOMMEND_INTERVAL=15
# 插画推荐每次处理数量 (默认: 30)
SCHEDULER_ILLUST_RECOMMEND_LIMIT=30

# 作者推荐任务处理间隔 (默认: 15分钟)
SCHEDULER_AUTHOR_RECOMMEND_INTERVAL=15
# 作者推荐每次处理数量 (默认: 30)
SCHEDULER_AUTHOR_RECOMMEND_LIMIT=30

# 详细信息任务处理间隔 (默认: 5分钟)
SCHEDULER_DETAIL_INFO_INTERVAL=5
# 详细信息每次处理数量 (默认: 50)
SCHEDULER_DETAIL_INFO_LIMIT=50

# ==========================================
# Auto TopN Preview
# ==========================================

# Default API params for action=auto-topn-preview
AUTO_PREVIEW_DEFAULT_LIMIT=120
AUTO_PREVIEW_MIN_POPULARITY=0
AUTO_PREVIEW_SIZES=thumb_mini,small

# Scheduler task for action=auto-topn-preview
SCHEDULER_AUTO_PREVIEW_ENABLED=true
SCHEDULER_AUTO_PREVIEW_INTERVAL=60
SCHEDULER_AUTO_PREVIEW_LIMIT=120
SCHEDULER_AUTO_PREVIEW_MIN_POPULARITY=0
SCHEDULER_AUTO_PREVIEW_SIZES=thumb_mini,small

# Candidate score refresh helper
CANDIDATE_SCORE_REFRESH_LIMIT=200

# ==========================================
# Backfill Preview
# ==========================================

BACKFILL_PREVIEW_DEFAULT_LIMIT=30
BACKFILL_PREVIEW_MIN_POPULARITY=0
BACKFILL_PREVIEW_MIN_AGE_DAYS=30
BACKFILL_PREVIEW_SIZES=thumb_mini,small

SCHEDULER_BACKFILL_PREVIEW_ENABLED=false
SCHEDULER_BACKFILL_PREVIEW_INTERVAL=1440
SCHEDULER_BACKFILL_PREVIEW_LIMIT=30
SCHEDULER_BACKFILL_PREVIEW_MIN_POPULARITY=0
SCHEDULER_BACKFILL_PREVIEW_MIN_AGE_DAYS=30
SCHEDULER_BACKFILL_PREVIEW_SIZES=thumb_mini,small
